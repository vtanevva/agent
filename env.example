# Copy this file to .env in the repo root and fill in your own values.
#   cp env.example .env
#
# Only OPENAI_API_KEY is required to get the app running locally.
# Everything else enables an optional integration (Google, Microsoft, Slack,
# Pinecone/RAG) — leave those commented out until you need them.

# ───────────────────────────────────────────────────────────────────
# Required
# ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ───────────────────────────────────────────────────────────────────
# App / environment
# ───────────────────────────────────────────────────────────────────
APP_ENV=development
FLASK_ENV=development
FLASK_SECRET_KEY=dev-secret-key-change-in-prod
DEBUG=true
LOG_LEVEL=INFO

# ───────────────────────────────────────────────────────────────────
# Core backend (backend/core_app.py, :5000) — local SQLite
# ───────────────────────────────────────────────────────────────────
SQLITE_PATH=storage/aivis.db
# Base URL the AI service uses to call back into the core backend.
CORE_BACKEND_URL=http://localhost:5000

# ───────────────────────────────────────────────────────────────────
# AI service (backend/ai_app.py, :5055) — orchestrator + LLM
# ───────────────────────────────────────────────────────────────────
AI_CHAT_PORT=5055
# Base URL the core backend uses to call the AI service.
AI_SERVICE_URL=http://127.0.0.1:5055
AI_SERVICE_TIMEOUT=120
# Optional shared secret — set the same value on both processes to require it.
# AI_SERVICE_SECRET=

# ───────────────────────────────────────────────────────────────────
# LLM
# ───────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=768
EMBEDDING_MODEL=text-embedding-ada-002

# ───────────────────────────────────────────────────────────────────
# Feature flags
# ───────────────────────────────────────────────────────────────────
ENABLE_MEMORY=true
ENABLE_RAG=false
ENABLE_AUTOGEN=false

# ───────────────────────────────────────────────────────────────────
# Vector DB (Pinecone) — only needed if ENABLE_RAG=true
# ───────────────────────────────────────────────────────────────────
# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=aivis
# PINECONE_ENV=us-east-1

# ───────────────────────────────────────────────────────────────────
# Google OAuth (Gmail + Calendar) — optional, required for email/calendar
# features. Download an OAuth client from Google Cloud Console and save it
# as google_client_secret.json in the repo root (or point GOOGLE_SECRET_FILE
# elsewhere).
# ───────────────────────────────────────────────────────────────────
GOOGLE_SECRET_FILE=google_client_secret.json
OAUTH_REDIRECT_URI=http://localhost:5000/google/oauth2callback
# GMAIL_PUBSUB_TOPIC=
# GMAIL_PUBSUB_WEBHOOK_SECRET=

# ───────────────────────────────────────────────────────────────────
# Microsoft OAuth (Outlook Calendar) — optional
# ───────────────────────────────────────────────────────────────────
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ───────────────────────────────────────────────────────────────────
# Instagram / Meta — optional
# ───────────────────────────────────────────────────────────────────
# IG_APP_ID=
# IG_APP_SECRET=

# ───────────────────────────────────────────────────────────────────
# Slack — optional
# ───────────────────────────────────────────────────────────────────
# SLACK_BOT_TOKEN=
# SLACK_WEBHOOK_SECRET=

# ───────────────────────────────────────────────────────────────────
# Rate limiting
# ───────────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=10

# ───────────────────────────────────────────────────────────────────
# Frontend
# ───────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:8081
